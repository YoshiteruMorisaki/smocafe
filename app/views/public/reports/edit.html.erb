<% content_for :title, "Smocafe | 投稿編集" %>

<div class="container py-5">
  <div class="mb-4">
    <%= link_to users_my_page_path, class: "btn btn-link px-0 text-decoration-none" do %>
      <i class="fa-solid fa-arrow-left me-1"></i>マイページへ戻る
    <% end %>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
          <h1 class="h3 mb-2">投稿を編集</h1>
          <p class="text-secondary mb-4">
            <span class="fw-semibold text-dark"><%= @shop.name %></span> への投稿を編集します。
          </p>

          <%= render "form",
                shop: @shop,
                report: @report,
                tags: @tags,
                form_url: report_path(@report),
                form_method: :patch,
                submit_label: "更新する",
                cancel_path: users_my_page_path,
                cancel_label: "キャンセル" %>
        </div>
      </div>
    </div>
  </div>
</div>
